<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The extension needs the same App Group as the main app so it can read
	     the schedule/app-selection and write the shared "restriction active"
	     flag and shield state. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bedlock.shared</string>
	</array>
</dict>
</plist>
